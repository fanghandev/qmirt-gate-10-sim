[Unit]
Description=QMIRT SRM dashboard backend (all campaigns)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/share/micromamba/envs/opengate/bin:/usr/local/bin:/usr/bin:/bin
# Binds to loopback; nginx (sites-available/srm-monitor) publishes it on 80/443.
ExecStart=/bin/bash %h/Work/RPIL/QMIRT/qmirt-gate-10-sim/monitor/run_monitor.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
