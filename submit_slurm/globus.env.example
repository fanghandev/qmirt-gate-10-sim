# Globus pull configuration for globus_pull_campaign.py (workstation side).
# Copy to globus.env and edit; globus.env is gitignored.

# Source: the collection that exposes the cluster campaign directory.
# NOTE: the SDSC Expanse Lustre collection is rooted at /expanse/lustre, so paths
# here are collection-relative (/projects/...), not the POSIX path Slurm sees.
QMIRT_SRC_ENDPOINT=8735b734-00dc-4659-be0d-ff96beaff17b
QMIRT_SRC_PATH=/projects/mgh102/fhan1/brain_spect_sim/batch_YYYYMMDD_HHMMSS

# Same campaign directory reached through the sshfs mount of the Expanse project dir
# (`expanse:/expanse/lustre/projects/mgh102/fhan1` -> `~/sdsc-expanse`).
# When set, directory listings and progress files are read here instead of over Globus,
# so routine progress polling never creates a Globus transfer task.
QMIRT_MOUNT_PATH=/home/fanghan/sdsc-expanse/brain_spect_sim/batch_YYYYMMDD_HHMMSS

# Destination: Globus Connect Personal on the workstation.
QMIRT_DST_ENDPOINT=c88668d2-ab9f-11f1-b472-0afff7074b21
QMIRT_DST_PATH=/data/fanghan/opengate_sim/data/brain_spect/batch_YYYYMMDD_HHMMSS

# POSIX path of QMIRT_DST_PATH on this machine; only differs if the collection
# is rooted somewhere other than /.
QMIRT_LOCAL_PATH=/data/fanghan/opengate_sim/data/brain_spect/batch_YYYYMMDD_HHMMSS

# The globus CLI is installed in the opengate micromamba env on rpil64c.
QMIRT_GLOBUS_CLI=/home/fanghan/.local/share/micromamba/envs/opengate/bin/globus

# Campaign array size (--job-count), used for completion percentages in the dashboard.
QMIRT_EXPECTED_TASKS=100
